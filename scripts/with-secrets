#!/usr/bin/env bash
# Run a command with the named local secrets exported into its environment.
# Usage: scripts/with-secrets VAR[,VAR...] -- <command> [args...]
#
# The secrets file is parsed, not sourced: one literal KEY=value per line,
# blank lines and lines starting with # ignored. Only the named variables
# are exported; naming a variable absent from the file is an error.
set -euo pipefail

file="${MKB_SECRETS_FILE:-$HOME/.config/mini-kanban-board/secrets.env}"

die() { echo "with-secrets: $*" >&2; exit 1; }

[[ $# -ge 3 && "$2" == "--" ]] || {
  echo "usage: $0 VAR[,VAR...] -- <command> [args...]" >&2
  exit 2
}
IFS=, read -r -a wanted <<< "$1"
shift 2

# Trust checks: regular file (not a symlink), owned by us, mode 600 or
# stricter, in a directory owned by us and not writable by others.
[[ -e "$file" ]] || die "not found: $file (see secrets.env.example)"
[[ -L "$file" ]] && die "refusing symlink: $file"
[[ -f "$file" ]] || die "not a regular file: $file"
dir="$(dirname "$file")"
file_owner="$(stat -c %u "$file")" || die "cannot stat $file"
file_mode="$(stat -c %a "$file")" || die "cannot stat $file"
dir_owner="$(stat -c %u "$dir")" || die "cannot stat $dir"
dir_mode="$(stat -c %a "$dir")" || die "cannot stat $dir"
[[ "$file_owner" == "$(id -u)" ]] || die "$file is not owned by you"
[[ "$dir_owner" == "$(id -u)" ]] || die "$dir is not owned by you"
(( (8#$file_mode & 8#077) == 0 )) || die "$file must be mode 600 (chmod 600 $file)"
(( (8#$dir_mode & 8#022) == 0 )) || die "$dir must not be group/world-writable"

declare -A values=()
lineno=0
while IFS= read -r line || [[ -n "$line" ]]; do
  lineno=$((lineno + 1))
  [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
  [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)=(.*)$ ]] || die "$file:$lineno: expected KEY=value"
  values["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
done < "$file"

for name in "${wanted[@]}"; do
  [[ "$name" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "invalid variable name: $name"
  [[ -n "${values[$name]:-}" ]] || die "$name is not set in $file"
  export "$name=${values[$name]}"
done

exec "$@"
