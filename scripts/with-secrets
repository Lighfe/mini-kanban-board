#!/usr/bin/env bash
# Run a command with local secrets exported into its environment only.
# Usage: scripts/with-secrets <command> [args...]
set -euo pipefail

file="${MKB_SECRETS_FILE:-$HOME/.config/mini-kanban-board/secrets.env}"

if [[ $# -eq 0 ]]; then
  echo "usage: $0 <command> [args...]" >&2
  exit 2
fi
if [[ ! -f "$file" ]]; then
  echo "secrets file not found: $file (see secrets.env.example)" >&2
  exit 1
fi
if [[ -n "$(find "$file" -perm /077)" ]]; then
  echo "refusing to load $file: permissions must be 600 (chmod 600 $file)" >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
source "$file"
set +a
exec "$@"
