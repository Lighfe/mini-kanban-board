# Template for local secrets. The real file lives outside the repo:
#   ~/.config/mini-kanban-board/secrets.env   (dir 700, file 600)
# Override the location with MKB_SECRETS_FILE.
#
# Format: one literal KEY=value per line, no quotes, no shell syntax.
# The file is parsed, not sourced.
#
# Pass only the variables a command needs:
#   scripts/with-secrets TYPESAFE_API_KEY -- <command>

# TypeSafe (Jev), used by tools/jev/.
TYPESAFE_API_KEY=

# AWS: use an SSO profile (`aws sso login --profile <name>`), not static keys.
# AWS_PROFILE=
